generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ══════════════════════════════════════════════════════════════════════════════
// ORGANIZATION — Mission 6.0 Phase P1 (B2B2C enabler)
//
// An Organization represents a wedding agency / event planner that manages
// MULTIPLE weddings. This is the critical missing layer for B2B2C: today
// AdminUser.weddingId is 1:1 (one user → one wedding), which blocks agency
// teams (5 staff × 50 weddings).
//
// With Organization:
//   - AdminUser.organizationId → Organization (nullable, backward compat)
//   - OrganizationMember join table (user ↔ org with role)
//   - Wedding.organizationId → Organization (nullable, backward compat)
//
// Access path: user → OrganizationMember → Organization → Wedding[]
// Backward compat: existing users with weddingId set still work (per-wedding
// access via assertWeddingAccess). New org members get org-scoped access to
// ALL weddings under their org.
// ══════════════════════════════════════════════════════════════════════════════

model Organization {
  id              String   @id @default(cuid())
  slug            String   @unique // for /org/[slug]/admin routing
  name            String
  email           String   @unique // primary contact
  phone           String?

  // ── Branding / White Label (P1.10) ───────────────────────────────────────
  logoUrl         String?
  brandColor      String?  // primary brand color override (hex)
  customDomain    String?  @unique // white-label domain (e.g. mariage-agency.fr)

  // ── Mission 6.0 P3.1 — Brand Kit (org-level brand identity) ──────────────
  // Optional FK to a Brand record (logo + colors + typography + voice/tone).
  // When set, the deployment pipeline's resolveBrand stage reads this brand
  // and embeds it in PublishedConfig.brand so the frontend renders the
  // agency's brand badge + applies voice rules to AI-generated copy.
  brandId         String?

  // ── Stripe (P2.5) — org-level billing for credit packs ───────────────────
  stripeCustomerId String? @unique // Stripe customer ID for org-level billing (P2.5)

  // ── Status ───────────────────────────────────────────────────────────────
  status          String   @default("ACTIVE") // ACTIVE | SUSPENDED | ARCHIVED
  plan            String   @default("TRIAL")  // TRIAL | ESSENTIEL | PREMIUM | ELITE (org-level)

  // ── Limits (org-level, overrides per-wedding for agency model) ───────────
  maxWeddings     Int      @default(1)  // how many weddings this org can manage
  maxMembers      Int      @default(5)  // how many members can join
  maxInvitationsPerMonth Int @default(50)  // P2.8 — org-level monthly invitation quota

  // ── Metadata ─────────────────────────────────────────────────────────────
  description     String?
  websiteUrl      String?
  address         String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // ── Relations ────────────────────────────────────────────────────────────
  members         OrganizationMember[]
  weddings        Wedding[]
  // P1.2 — AdminUsers who have this org as their "primary org" (denormalized FK
  // on AdminUser.organizationId for quick lookups). The authoritative multi-org
  // membership is in OrganizationMember (join table).
  primaryMembers  AdminUser[]
  // Mission 6.0 P2.1 — Credits system (org-level for white-label)
  credits             Credit[]
  creditTransactions  CreditTransaction[]
  creditBalances      CreditBalance[]
  // Mission 6.0 P3.1 — Brand Kit relation (optional)
  brand               Brand?  @relation(fields: [brandId], references: [id], onDelete: SetNull)

  @@index([status])
}

model OrganizationMember {
  id              String   @id @default(cuid())
  organizationId  String
  userId          String   // → AdminUser.id
  // Roles: ORG_ADMIN (full org CRUD + invite), ORG_MEMBER (read/write weddings),
  //        ORG_VIEWER (read-only)
  role            String   @default("ORG_MEMBER")
  invitedBy       String?  // → AdminUser.id (who invited this member)
  invitedAt       DateTime @default(now())
  joinedAt        DateTime? // null until the invite is accepted
  status          String   @default("PENDING") // PENDING | ACTIVE | REVOKED

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user            AdminUser    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId]) // one membership per org per user
  @@index([userId])
  @@index([organizationId, status])
}

// ══════════════════════════════════════════════════════════════════════════════
// TENANT — A Wedding is the top-level tenant entity.
// Each wedding owns its guests, tables, settings, media, timeline, etc.
// ══════════════════════════════════════════════════════════════════════════════

model Wedding {
  id              String        @id @default(cuid())
  slug            String        @unique // e.g. "josue-hornella" — used in /w/{slug} routing
  brideName       String        @default("")
  groomName       String        @default("")
  coupleLabel     String        @default("") // computed display: "Josué & Hornella"
  weddingDate     DateTime?
  timezone        String        @default("Africa/Kinshasa")
  venueName       String?
  venueAddress    String?
  venueCity       String?
  venueLat        String?
  venueLng        String?
  venueReference  String?
  status          String        @default("DRAFT") // DRAFT, PUBLISHED, COMPLETED, ARCHIVED, SUSPENDED
  plan            String        @default("TRIAL") // TRIAL, ESSENTIEL, PREMIUM, ELITE
  customDomain    String?       @unique // e.g. "mariage-sophie.fr" (Premium/Élite only)
  // P5.2-2 (PRE-P5.X-AUDIT-B, HIGH-4): DNS verification gate for custom domains.
  // Set to false whenever customDomain changes; flipped to true only after the
  // couple adds the TXT record _heureux-mariage.{domain} and the
  // /verify-domain endpoint confirms the token is present in DNS. The
  // /api/resolve-domain resolver blocks routing for unverified domains.
  customDomainVerified Boolean  @default(false)
  isDefault       Boolean       @default(false) // marks the legacy wedding served at "/"
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  publishedAt     DateTime?

  // ─── Mission 6.0 P1.2 — Organization FK (B2B2C) ────────────────────────────
  // Nullable for backward compat: existing weddings have no org. New weddings
  // created by org members get organizationId set. When set, all org members
  // (ORG_ADMIN/ORG_MEMBER/ORG_VIEWER) inherit access to this wedding via the
  // org membership chain (assertWeddingAccess checks org → wedding).
  organizationId    String?
  organization      Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  // ─── Mission 5.0 — Commercial OS ────────────────────────────────────────────
  customerId        String?          // link to Customer (nullable, additive)
  customer          Customer?        @relation(fields: [customerId], references: [id], onDelete: SetNull)
  commercialStatus  String?          // LEAD/PENDING_PAYMENT/PAID/IN_PRODUCTION/READY/LIVE/COMPLETED/ARCHIVED/CANCELLED

  // ─── Mission 4.7 Phase 4 — Portfolio Governance ────────────────────────────
  // Explicit DB-backed marketing governance. Replaces the implicit slug-based
  // classification (DEMO_SLUGS set in page.tsx) with admin-controlled fields.
  //   portfolioVisible: null = default (PUBLISHED non-default weddings visible)
  //   portfolioType: CLIENT | DEMO | INTERNAL — null = transitional slug-based
  //   portfolioOrder: explicit display order (null = sort by createdAt desc)
  //   caseStudyEnabled: true = THE case study (typically josue-hornella)
  //   featured: highlighted/sticky in portfolio
  portfolioVisible   Boolean?
  portfolioType      String? // CLIENT | DEMO | INTERNAL
  portfolioOrder     Int?
  caseStudyEnabled   Boolean   @default(false)
  featured           Boolean   @default(false)

  // ─── Collection Engine (Phase 1 — additive, nullable for zero regression) ───
  // When a couple picks a Collection Product, the Wedding is linked to it so the
  // ThemeInjector + LuxuryVisualEngine hydrate from the Collection's seeds.
  // Nullable: existing weddings have collectionId = null → behavior unchanged.
  collectionId    String?
  collection      Collection?   @relation(fields: [collectionId], references: [id])
  variantId       String?
  // P1+P2 — denormalized version snapshot (mirrors WeddingCollectionBinding.collectionVersion
  // for fast reads at render time without a join).
  collectionVersion String?

  // P1 — full binding history (1:N, one ACTIVE per wedding enforced by unique constraint).
  collectionBindings WeddingCollectionBinding[]

  // Relations — every tenant-scoped entity points back to its Wedding
  admins          AdminUser[]
  guests          Guest[]
  // P4.1 — Guestbook (livre d'or) entries for this wedding.
  guestbookEntries GuestbookEntry[]
  tables          Table[]
  media           Media[]
  timeline        EventTimeline[]
  stories         CoupleStory[]
  settings        Settings[]
  theme           Theme?
  music           MusicTrack?
  auditLogs       AuditLog[]
  guestSessions   GuestSession[]
  guestAccessLogs GuestAccessLog[]
  subscription    Subscription?
  usageCounters   UsageCounter[]
  invitations     Invitation[]
  invoices        Invoice[]
  // Mission 5.7.1 — design pipeline relations
  exportJobs      ExportJob[]
  // Mission 5.0 — Commercial OS relations (customer field defined above with customerId)
  deals           Deal[]
  orders          CommercialOrder[]
  payments        Payment[]
  entitlements    Entitlement[]
  deliveryJobs    DeliveryJob[]
  // CONS-3-SUPER-ADMIN: Production Studio deployments using this wedding.
  deployments    Deployment[]
  // CONS-5-CLIENT-BACKEND — per-wedding client backend entities.
  families       Family[]
  guestGroups    GuestGroup[]
  gifts          Gift[]
  programItems   ProgramItem[]
  // Mission 6.0 P2.1 — Credits system
  credits             Credit[]
  creditTransactions  CreditTransaction[]
  creditBalances      CreditBalance[]
  // Mission 6.0 P3.1+P3.2 — Brand Kit + Layout (optional wedding-level overrides)
  brand               Brand?   @relation(fields: [brandId], references: [id], onDelete: SetNull)
  layout              Layout?  @relation(fields: [layoutId], references: [id], onDelete: SetNull)
  // Mission 6.0 P3.4 — Experience (post-deploy analytics, A/B variants, reports)
  experienceEvents    ExperienceEvent[]
  experienceVariants  ExperienceVariant[]
  experienceReports   ExperienceReport[]

  // ─── CONS-6-PIPELINE — published frontend snapshot ────────────────────────
  // Snapshot of the last successful deployment pipeline run. Consumed by
  // /w/[slug]/layout.tsx (server) and rendered via ThemeInjector + SectionRenderer.
  // publishedVersion mirrors Deployment.version for fast equality checks.
  publishedConfigJson String?
  publishedVersion   String?

  // ─── Mission 6.0 P3.1 — Brand Kit (optional wedding-level override) ───────
  // When set, overrides the org-level brand for this specific wedding
  // (e.g. a couple's monogram + ceremony aesthetic). Null = inherit from org.
  brandId            String?

  // ─── Mission 6.0 P3.2 — Layout (first-class) ──────────────────────────────
  // When set, the resolveLayouts stage reads this layout's sectionsJson
  // instead of falling back to the hardcoded LAYOUT_SECTIONS map.
  layoutId           String?

  @@index([organizationId])
  @@index([status, organizationId])
}

// ══════════════════════════════════════════════════════════════════════════════
// AUTH — AdminUser (kept name for backward compat; Phase 3 will alias to User)
// Roles: SUPER_ADMIN (platform owner, weddingId=null), ORGANIZER (per-wedding owner),
//        CONTROLLER / RECEPTION (per-wedding staff)
// ══════════════════════════════════════════════════════════════════════════════

model AdminUser {
  id           String     @id @default(cuid())
  email        String     @unique
  password     String
  name         String
  // Roles: SUPER_ADMIN, PLATFORM_ADMIN, ORGANIZER, RECEPTION, CONTROLLER,
  //        DESIGNER (Phase 4 — Designer Portal access),
  //        ART_DIRECTOR (Phase 4 — validates submissions)
  // Mission 6.0 P1.3 — ORG_ADMIN, ORG_MEMBER, ORG_VIEWER (org-scoped, weddingId=null)
  role         String     @default("CONTROLLER")
  weddingId    String?    // null for SUPER_ADMIN/ORG_* (platform/org-wide); set for ORGANIZER/STAFF
  lastLoginAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  wedding      Wedding?   @relation(fields: [weddingId], references: [id], onDelete: Cascade)

  // ─── P5.1 H-DELEG-3 — Soft-suspend flag for per-wedding admins ──────────────
  // When true, the user is denied access in getAuthUser (real-time, 1-request
  // latency). Unlike hard delete, this preserves the AdminUser row + audit
  // history. Super Admin can re-activate by setting suspended=false.
  // NOTE: org-scoped admins use OrganizationMember.status='REVOKED' instead
  // (checked separately in getAuthUser via CRITICAL-GAP-1 fix).
  suspended    Boolean    @default(false)
  suspendedAt  DateTime?
  suspendedBy  String?    // → AdminUser.id (who suspended this user)

  // ─── Mission 6.0 P1.2 — Organization membership (B2B2C) ─────────────────────
  // Nullable for backward compat: existing users have no org. New org members
  // get this set. When set + role is ORG_*, the user accesses ALL weddings
  // under their org via the OrganizationMember join table.
  // NOTE: the authoritative membership is in OrganizationMember (join table),
  // which allows a user to belong to MULTIPLE orgs. This denormalized FK is
  // the "primary org" for quick lookups (dashboard routing, default context).
  organizationId    String?
  organization      Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  orgMemberships    OrganizationMember[]

  auditLogs    AuditLog[]
  // Phase 4 — Collections authored by this designer (inverse of Collection.authorId).
  authoredCollections Collection[] @relation("CollectionAuthor")
  // P1 — WeddingCollectionBinding deployments authored by this user.
  collectionBindings  WeddingCollectionBinding[]
  // Mission 5.0 — payments verified by this admin
  verifiedPayments    Payment[]
  // P4.1 — Guestbook entries approved/rejected by this admin.
  approvedGuestbookEntries GuestbookEntry[]
  // Mission 5.7.1 — design pipeline relations
  authoredDesignVersions DesignVersion[] @relation("DesignVersionAuthor")

  // ── P1-SEC-8: TOTP-based 2FA for platform admins ─────────────────────────
  // twoFactorSecret: TOTP secret (encrypted-at-rest via encryptId/decryptId
  //   in lib/two-factor.ts). null when 2FA has never been set up.
  // twoFactorEnabled: flipped to true only after the user verifies a TOTP
  //   code during setup. Until then, the secret is "pending confirmation".
  // twoFactorBackupCodes: JSON array of SHA-256-hashed one-time backup codes.
  //   Cleared on disable. null when 2FA is off.
  twoFactorSecret       String?
  twoFactorEnabled      Boolean    @default(false)
  twoFactorBackupCodes  String?

  @@index([weddingId])
  @@index([organizationId])
}

// ══════════════════════════════════════════════════════════════════════════════
// BILLING — Manual WhatsApp-driven billing (Phase 6, revised)
//
// Originally designed for Stripe (Phase 6 spec). Re-purposed for a manual
// sales workflow: the platform admin negotiates a price with the couple
// (based on the services included in the chosen plan), sends a prefilled
// WhatsApp message with the offer + payment instructions, and manually
// confirms the invoice as PAID once payment is received outside the
// platform (mobile money, bank transfer, cash).
//
// Stripe columns are kept (nullable) for a future opt-in migration; they
// are not used by the current billing flow.
// ══════════════════════════════════════════════════════════════════════════════

model Subscription {
  id                     String    @id @default(cuid())
  weddingId              String    @unique
  wedding                Wedding   @relation(fields: [weddingId], references: [id], onDelete: Cascade)

  // ── Plan & pricing ──
  plan                   String    @default("TRIAL") // TRIAL, ESSENTIEL, PREMIUM, ELITE
  status                 String    @default("TRIALING") // TRIALING, PENDING_PAYMENT, ACTIVE, PAST_DUE, SUSPENDED, CANCELED, EXPIRED
  amountAgreed           Int?      // negotiated price in minor units (cents). null = use plan default.
  currency               String    @default("usd") // usd, eur, fcfa
  billingCycle           String    @default("MONTHLY") // MONTHLY, ANNUAL, ONE_TIME

  // ── Period ──
  currentPeriodStart     DateTime?
  currentPeriodEnd       DateTime?
  cancelAt               DateTime?
  trialEndsAt            DateTime?
  activatedAt            DateTime? // first time marked ACTIVE (i.e. first payment received)
  paidAt                 DateTime? // last payment received timestamp

  // ── Manual billing metadata ──
  paymentMethod          String?   // MOBILE_MONEY, BANK_TRANSFER, CASH, OTHER
  whatsappPhone          String?   // client's WhatsApp number (E.164 or local format)
  notes                  String?   // admin freeform notes about the negotiation

  // ── Stripe (reserved for future opt-in, currently unused) ──
  stripeCustomerId       String?   @unique
  stripeSubscriptionId   String?   @unique

  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  invoices               Invoice[]
}

model Invoice {
  id               String       @id @default(cuid())
  subscriptionId   String
  subscription     Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  weddingId        String       // denormalized for direct platform-wide queries
  wedding          Wedding      @relation(fields: [weddingId], references: [id], onDelete: Cascade)

  // ── Amounts ──
  amountDue        Int          // in minor units (cents)
  amountPaid       Int          @default(0)
  currency         String       @default("usd")
  billingCycle     String       @default("MONTHLY") // echoed from subscription at creation time

  // ── Status ──
  status           String       @default("OPEN") // DRAFT, OPEN, PAID, VOID
  paymentMethod    String?      // MOBILE_MONEY, BANK_TRANSFER, CASH, OTHER

  // ── Manual billing workflow ──
  whatsappSentAt   DateTime?   // last time a WhatsApp message was sent for this invoice
  whatsappPhone    String?     // phone the WhatsApp message was sent to
  confirmedBy      String?     // AdminUser.id who marked the invoice PAID
  notes            String?     // admin freeform notes

  // ── Stripe (reserved for future opt-in, currently unused) ──
  stripeInvoiceId  String?   @unique
  pdfUrl           String?
  hostedInvoiceUrl String?

  paidAt           DateTime?
  createdAt        DateTime     @default(now())

  @@index([weddingId, status])
  @@index([subscriptionId])
}

model UsageCounter {
  id          String   @id @default(cuid())
  weddingId   String
  wedding     Wedding  @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  metric      String   // GUESTS, MEDIA_BYTES, ADMINS, QR_SCANS
  value       Int      @default(0)
  period      String   // "2026-06" for monthly metered
  updatedAt   DateTime @updatedAt

  @@unique([weddingId, metric, period])
  @@index([weddingId, metric])
}

// ══════════════════════════════════════════════════════════════════════════════
// TENANT-SCOPED CONTENT
// ══════════════════════════════════════════════════════════════════════════════

model Guest {
  id                  String         @id @default(cuid())
  weddingId           String         // NOT NULL since Phase 2 — every guest belongs to exactly one wedding
  wedding             Wedding        @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  firstName           String
  lastName            String
  displayName         String?        // Exact display name as shown on invitation (no transformation)
  invitationType      String         @default("individuel") // couple, individuel
  phone               String?
  email               String?
  tableId             String?
  seats               Int            @default(1)
  category            String         @default("AMIS") // VIP, FAMILLE, AMIS, SPONSORS, COLLEGUES
  status              String         @default("PENDING") // CONFIRMED, PENDING, DECLINED
  invitationCode      String         // uniqueness now scoped by wedding (see @@unique below)
  personalMessage     String?
  // ─── Mission 6.0 P4.2 — Dietary preferences ─────────────────────────────
  // Free-form text input from guest during RSVP (allergies, restrictions, etc).
  dietary             String?
  checkedIn           Boolean        @default(false)
  checkedInAt         DateTime?
  invitationViewed    Boolean        @default(false)
  invitationViewedAt  DateTime?
  invitationViewCount Int            @default(0)
  lastAccessAt        DateTime?
  // ─── RSVP Fields ───
  rsvpAt              DateTime?
  rsvpMessage         String?
  rsvpPlusOne         Boolean        @default(false)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  table               Table?         @relation(fields: [tableId], references: [id])
  sessions            GuestSession[]
  accessLogs          GuestAccessLog[]
  // P4.1 — Guestbook entries authored by this guest (anonymous entries have guestId=null).
  guestbookEntries    GuestbookEntry[]
  deliveryJobs        DeliveryJob[]
  // CONS-5-CLIENT-BACKEND — optional family + group relations.
  // Nullable for backward compat (existing guests have null).
  familyId            String?
  family              Family?    @relation(fields: [familyId], references: [id], onDelete: SetNull)
  groupId             String?
  group               GuestGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)

  @@unique([weddingId, invitationCode]) // uniqueness within wedding only
  @@index([weddingId, status])
  @@index([weddingId, category])
  @@index([weddingId, tableId])
  // Mission 6.0 P0.3 — performance indexes for QR lookup + RSVP stats
  // (removed redundant @@index([weddingId, invitationCode]) — covered by @@unique above)
  @@index([weddingId, rsvpAt])
  @@index([weddingId, checkedIn])
}

model Table {
  id        String   @id @default(cuid())
  weddingId String   // NOT NULL since Phase 2
  wedding   Wedding  @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  name      String
  number    Int      // not globally unique anymore — scoped by wedding
  capacity  Int      @default(8)
  location  String?  // JSON string for position: {"x": 0, "y": 0}
  guests    Guest[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([weddingId, number])
  @@index([weddingId])
}

model Media {
  id              String   @id @default(cuid())
  weddingId       String   // NOT NULL since Phase 2
  wedding         Wedding  @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  type            String   // PHOTO, VIDEO, LOGO, DOCUMENT
  storageProvider String   @default("LOCAL") // LOCAL, R2 (Phase 9)
  storageKey      String?  // path or R2 key
  url             String
  title           String?
  description     String?
  category        String?  // GALLERY, COUPLE_STORY, DOCUMENT, OTHER
  sizeBytes       Int      @default(0)
  mime            String?
  order           Int      @default(0)
  // Mission 5.7.1 — links design asset (FONT/SVG) to a Collection. Null for
  // per-wedding media (the original use case). When set, this Media row is a
  // shared design library asset owned by the Collection.
  collectionId    String?
  collection      Collection? @relation(fields: [collectionId], references: [id], onDelete: SetNull)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([weddingId, category])
  @@index([weddingId, type])
  @@index([collectionId])
}

model EventTimeline {
  id          String   @id @default(cuid())
  weddingId   String   // NOT NULL since Phase 2
  wedding     Wedding  @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  time        String
  activity    String
  location    String?
  description String?
  icon        String?  // Emoji or icon identifier
  // ─── Mission 6.0 P4.3 — ProgramItem/EventTimeline merge ──────────────────
  // When set, this timeline entry has been migrated to a ProgramItem (the
  // canonical model going forward). The migration script sets this + keeps
  // the original EventTimeline row for audit. UI reads from ProgramItem only.
  migratedToProgramItemId String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([weddingId])
}

model CoupleStory {
  id          String   @id @default(cuid())
  weddingId   String   // NOT NULL since Phase 2
  wedding     Wedding  @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  title       String
  description String
  date        String?
  imageUrl    String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([weddingId])
}

// ══════════════════════════════════════════════════════════════════════════════
// PER-WEDDING CONFIG
// ══════════════════════════════════════════════════════════════════════════════

model Settings {
  id        String   @id @default(cuid())
  weddingId String   // NOT NULL since Phase 2
  wedding   Wedding  @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  key       String   // not globally unique anymore — scoped by wedding
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([weddingId, key])
  @@index([weddingId])
}

model Theme {
  id              String   @id @default(cuid())
  weddingId       String   @unique
  wedding         Wedding  @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  primaryColor    String   @default("#D4A853")
  accentColor     String   @default("#C8785A")
  fontDisplay     String   @default("Cormorant Garamond")
  fontBody        String   @default("Inter")
  layout          String   @default("classic") // classic, modern, minimalist, royal
  customizations  String?  // JSON: { heroStyle, animationIntensity, ... }
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model MusicTrack {
  id              String   @id @default(cuid())
  weddingId       String   @unique
  wedding         Wedding  @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  storageProvider String   @default("LOCAL")
  storageKey      String?
  url             String
  title           String?
  volume          Float    @default(0.25)
  enabled         Boolean  @default(false)
  autoplay        Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ══════════════════════════════════════════════════════════════════════════════
// GUEST SESSIONS & LOGGING (tenant-scoped)
// ══════════════════════════════════════════════════════════════════════════════

model GuestSession {
  id             String   @id @default(cuid())
  weddingId      String   // NOT NULL since Phase 2
  wedding        Wedding  @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  guestId        String
  guest          Guest    @relation(fields: [guestId], references: [id], onDelete: Cascade)
  token          String   @unique
  userAgent      String?
  ipAddress      String?
  fingerprint    String?  // Device fingerprint hash
  deviceInfo     String?  // JSON: { browser, os, device, isMobile }
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  expiresAt      DateTime
  lastAccessedAt DateTime @default(now())

  @@index([weddingId, guestId])
}

model GuestAccessLog {
  id          String   @id @default(cuid())
  weddingId   String   // NOT NULL since Phase 2
  wedding     Wedding  @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  guestId     String?
  guest       Guest?   @relation(fields: [guestId], references: [id], onDelete: SetNull)
  action      String   // LOGIN, VIEW_INVITATION, ACCESS_DENIED, LOGOUT, QR_SCAN, LINK_VISIT, SEARCH_BLOCKED
  details     String?
  userAgent   String?
  ipAddress   String?
  referrer    String?
  fingerprint String?
  deviceInfo  String?
  createdAt   DateTime @default(now())

  @@index([weddingId, createdAt])
  @@index([weddingId, guestId])
}

model AuditLog {
  id        String    @id @default(cuid())
  weddingId String?   // null = platform-level event
  // P5.1 H-DEL-2 — Changed from Cascade to SetNull to preserve audit history
  // when a wedding is deleted. Previously, deleting a wedding destroyed its
  // ENTIRE audit trail (RSVPs, logins, config changes). Now the weddingId is
  // nullified but the log entry survives for forensic/RGPD purposes.
  wedding   Wedding?  @relation(fields: [weddingId], references: [id], onDelete: SetNull)
  userId    String?
  user      AdminUser? @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  details   String?
  // P1-SEC-12: forensic fields — IP + UserAgent for security audits.
  // Both nullable for backward compat (existing rows have neither).
  ipAddress String?
  userAgent  String?
  // P5.2 — Audit trail enrichment (HIGH-AUDIT-1 + HIGH-AUDIT-2)
  // result: 'SUCCESS' | 'FAILURE' — captures whether the action succeeded.
  // targetUserId: for user-targeted actions (create/revoke/suspend).
  // targetResourceId: for resource-targeted actions (wedding publish/delete).
  // targetType: 'WEDDING' | 'USER' | 'ORG' | 'COLLECTION' | 'DEPLOYMENT' | null.
  result           String?  // SUCCESS | FAILURE
  targetUserId     String?
  targetResourceId String?
  targetType       String?
  createdAt DateTime  @default(now())

  @@index([weddingId, createdAt])
  @@index([userId])
  @@index([ipAddress])
  @@index([targetUserId])
  @@index([targetResourceId])
}

// ══════════════════════════════════════════════════════════════════════════════
// ONBOARDING — Invitations sent via SMS/EMAIL/WHATSAPP (Phase 7)
// ══════════════════════════════════════════════════════════════════════════════

model Invitation {
  id          String   @id @default(cuid())
  weddingId   String
  wedding     Wedding  @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  channel     String   // SMS, EMAIL, WHATSAPP, QR
  recipient   String   // phone or email
  guestId     String?
  status      String   @default("PENDING") // PENDING, SENT, DELIVERED, FAILED, OPENED
  sentAt      DateTime?
  createdAt   DateTime @default(now())

  deliveryJobs DeliveryJob[]

  @@index([weddingId, status])
}

// ══════════════════════════════════════════════════════════════════════════════
// ONBOARDING — Public lead capture (Phase 7)
// A Lead is submitted by a prospective couple via the public /onboarding form.
// The platform admin reviews leads in the admin dashboard and converts them
// into a published Wedding via the onboarding wizard (transactional create).
// ══════════════════════════════════════════════════════════════════════════════

model Lead {
  id                 String    @id @default(cuid())
  brideName          String
  groomName          String
  coupleLabel        String    // computed via buildCoupleLabel at insert time
  weddingDate        DateTime?
  venueCity          String?
  email              String
  phone              String?
  plan               String    @default("TRIAL") // desired plan: TRIAL, ESSENTIEL, PREMIUM, ELITE
  message            String?   // freeform note from the couple
  status             String    @default("NEW") // NEW, CONTACTED, CONVERTED, REJECTED
  notes              String?   // admin private notes
  convertedWeddingId String?   // linked Wedding.id once converted (denormalized, no FK to avoid cascade complexity)
  convertedAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  deals              Deal[]   // Mission 5.0: inverse relation for Deal.leadId

  @@index([status])
  @@index([createdAt])
}

// ══════════════════════════════════════════════════════════════════════════════
// COLLECTION ENGINE — Phase 1 (AENEWS Wedding OS Enterprise)
// ══════════════════════════════════════════════════════════════════════════════
// A Collection Product is a commercial product that encapsulates a complete
// wedding design (theme seed + luxury preset + Penpot file reference) ready to
// be deployed automatically on a new wedding.
//
// Design principles (per validated spec):
//   - Wedding OS does NOT design — Penpot is the Studio. The Collection only
//     references Penpot files + stores the seed data.
//   - Additive only: every field is nullable or has a default. Existing
//     weddings have collectionId = null → behavior unchanged (DEFAULT_THEME).
//   - The Collection Engine ORCHESTRATES existing motors (Theme Engine,
//     ThemeInjector, LuxuryVisualEngine, PenpotStudio) — it does NOT replace
//     them.
//
// Phase 1 scope (minimal, immediately useful):
//   - Collection exists and can be selected/associated with a wedding
//   - Apply flow upserts Theme row + hydrates luxury preset
//   - Royal Gold is the first seeded Collection
//   - Modules (34 slots), Designer Portal, lifecycle 6-state, marketplace UI
//     are deferred to later phases (per user's phased recommendation).
// ══════════════════════════════════════════════════════════════════════════════

model Collection {
  id              String   @id @default(cuid())
  slug            String   @unique // e.g. "royal-gold" — used in catalog URLs
  name            String   // display name, e.g. "Royal Gold"
  description     String?
  thumbnailUrl    String?
  isActive        Boolean  @default(true) // visible in catalog when true
  isPublished     Boolean  @default(true) // published/commercialized gate (Phase 1: always true for seed)
  sortOrder       Int      @default(0)
  category        String   @default("LUXURY") // LUXURY, CLASSIC, AFRICAN, MINIMAL, DESTINATION, ...
  tier            String   @default("FREE") // marketplace tier: FREE, PREMIUM, EXCLUSIVE, ENTERPRISE, ...

  // Penpot master file reference (the design source of truth lives in Penpot)
  penpotFileUrl   String?
  penpotFileId    String?

  // Theme seed — applied to the Wedding's Theme row on deployment.
  // JSON shape: { primaryColor, accentColor, fontDisplay, fontBody, layout }
  themeSeed       String   // JSON string (SQLite has no native Json type — stored as text)

  // Luxury preset — hydrates LuxuryVisualEngine via ThemeInjector.
  // JSON shape: { theme: 'gold'|'rose'|'champagne'|'midnight', effects: {...}, intensity, density, speed, haloCount }
  // Nullable: when null, the LuxuryVisualEngine falls back to its localStorage behavior (unchanged).
  luxuryPreset    String?

  // ─── Phase 4 — Lifecycle 6 états (spec §3) ──────────────────────────────
  // status: BROUILLON | EN_COURS | VALIDATION | PUBLIE | COMMERCIALISE | ARCHIVE
  // Default COMMERCIALISE for backward compat with Phase 1/2/3 seed Collections
  // (they are already deployable, so they start in the terminal "commercialized" state).
  status          String   @default("COMMERCIALISE")
  // semver snapshot tag (e.g. "1.0.0"). Bumped on each VALIDATION transition.
  version         String   @default("0.1.0")
  // Designer who authored this Collection (nullable for legacy seed Collections).
  authorId        String?
  author          AdminUser? @relation("CollectionAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  // Lifecycle timestamps (set when entering the corresponding state).
  submittedAt     DateTime? // EN_COURS → VALIDATION
  publishedAt     DateTime? // VALIDATION → PUBLIE
  commercializedAt DateTime? // PUBLIE → COMMERCIALISE
  archivedAt      DateTime? // * → ARCHIVE

  // ─── Phase 5 — Penpot Collection Builder (auto-detection cache) ──────────
  // Designer-scoped Penpot API token (encrypted at rest in a future hardening
  // pass; for now stored as plaintext like other config). When null, the
  // global PENPOT_API_TOKEN env var is used.
  penpotTokenId   String?
  // Last time auto-detection ran successfully (cache for 304 short-circuit +
  // UI freshness indicator). Null = never synced.
  lastFrameSyncAt DateTime?
  // Cached quality score (0-100). Computed by computeQualityScore() and
  // refreshed on each auto-detect / module update / transition. Null = never
  // computed (legacy Collections from Phase 1-4 have null until first compute).
  qualityScore    Int?

  // ─── Mission 5.7.1 — Design Pipeline ──────────────────────────────────
  // Content hash for change detection (SHA-256 of the normalized design tree).
  sourceHash         String?
  // Cached design document JSON (pages/frames/nodes/tokens) from the latest ingestion.
  designDocument     String?
  // Cached full QualityReport JSON (not just the qualityScore int).
  qualityReportJson  String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  variants        CollectionVariant[]
  modules         CollectionModule[]
  weddings        Wedding[]
  // Mission 5.7.1 — design pipeline relations
  assets          Media[]
  designVersions  DesignVersion[]
  ingestionJobs   IngestionJob[]
  exportJobs      ExportJob[]
}

model CollectionVariant {
  id              String   @id @default(cuid())
  collectionId    String
  collection      Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  code            String   // "A" | "B" | "C" | "D"
  name            String   // display name, e.g. "Version A — Soirée"
  // JSON shape: { primaryColor?, accentColor?, fontDisplay?, fontBody? } — overrides Collection.themeSeed
  paletteOverride String?
  penpotPageId    String?  // Penpot page ID specific to this variant
  isDefault       Boolean  @default(false)
  createdAt       DateTime @default(now())

  @@unique([collectionId, code])
  @@index([collectionId])
}

// ══════════════════════════════════════════════════════════════════════════════
// Collection Engine — Phase 2: Module Slots (5 packs × 34 slots)
// ══════════════════════════════════════════════════════════════════════════════
// Each Collection Product must declare 34 module slots across 5 packs:
//   Pack 1 — WEBSITE      (10 slots: hero, countdown, story, gallery, programme, rsvp, footer, loader, splash, systemPages)
//   Pack 2 — INVITATIONS  (8 slots: standard, vip, famille, couple, presse, sponsor, numerique, impression)
//   Pack 3 — PRINT        (8 slots: badge, qr, parking, floorPlan, tableNumber, placeCard, remerciement, livreOr)
//   Pack 4 — COMMUNICATION(8 slots: whatsapp, facebook, instagram, story, email, banner, affiche, rollup)
//   Pack 5 — LUXURY       (1 composite, stored in Collection.luxuryPreset — no row needed here)
//
// Each slot maps to a Penpot frame ID. When frameId is null, the slot is
// "unmapped" and the renderer falls back to the existing component (zero regression).
// Completeness validation (§4.8): a Collection can be PUBLIÉ only when all 34 slots are mapped.
model CollectionModule {
  id              String   @id @default(cuid())
  collectionId    String
  collection      Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  pack            String   // "WEBSITE" | "INVITATIONS" | "PRINT" | "COMMUNICATION"
  slot            String   // e.g. "hero", "vip", "badge", "whatsapp"
  label           String   // human-readable label, e.g. "Section héros"
  // Penpot frame reference — null means "unmapped" (renderer falls back to existing component)
  frameId         String?
  penpotPageId    String?
  // Phase 5 — original frame name as authored in Penpot (for diagnostics +
  // drift detection: if the designer renames the frame, autoMapped=false rows
  // surface the mismatch on next sync).
  frameName       String?
  // Phase 5 — true when the mapping was set by auto-detection, false when the
  // designer manually overrode it. Manual overrides are preserved on re-sync.
  autoMapped      Boolean  @default(false)
  // For INVITATIONS pack only: which guest tier this slot serves (STANDARD/VIP/FAMILLE/COUPLE/PRESSE/SPONSOR)
  // null for all other packs.
  guestTier       String?
  // Mission 5.7.1 — semantic data bindings JSON (ProductBinding[] co-located).
  // Shape: [{ sourceNodeId, semanticRole, dataPath, fallback?, transform?, required }]
  dataBindings   String?
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([collectionId, pack, slot])
  @@index([collectionId])
}

// ══════════════════════════════════════════════════════════════════════════════
// PHASE C — COLLECTION BINDING (P1 — Collection as central entity)
// ══════════════════════════════════════════════════════════════════════════════
// A WeddingCollectionBinding records the deployment of a Premium Collection
// to a Wedding. There is at most one ACTIVE binding per wedding (enforced by
// `@@unique([weddingId])`), but the table keeps a small history: when a new
// Collection is deployed, the existing row is updated in place (status flips
// to DEPLOYED, previous manifest is archived in the `manifest` JSON column).
// ══════════════════════════════════════════════════════════════════════════════

model WeddingCollectionBinding {
  id                String   @id @default(cuid())
  weddingId         String   @unique // one active binding per wedding
  wedding           Wedding  @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  collectionId      String   // references Collection.id (kept as plain string for history snapshot)
  collectionVersion String   // e.g. "1.0.0"
  manifest          String   // JSON: PUBLISHED manifest (read by public renderer /w/[slug])
  draftManifest     String?  // JSON: DRAFT manifest (edited by Designer, not visible publicly until published)
  status            String   @default("DEPLOYED") // DEPLOYED, ARCHIVED, ROLLED_BACK
  deployedAt        DateTime @default(now())
  deployedByUserId  String?  // AdminUser.id of the deployer (null for system/migration)
  deployedBy        AdminUser? @relation(fields: [deployedByUserId], references: [id], onDelete: SetNull)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([collectionId])
  @@index([status])
}

// ══════════════════════════════════════════════════════════════════════════════
// P1-SEC-9 — PASSWORD RESET TOKENS
// ══════════════════════════════════════════════════════════════════════════════
// Time-limited, single-use tokens for the platform password-reset flow.
// The raw token is sent to the user via email; only its SHA-256 hash is stored.
// ══════════════════════════════════════════════════════════════════════════════

model PasswordResetToken {
  id        String    @id @default(cuid())
  email     String    // the AdminUser.email the reset is for (denormalized for lookup)
  token     String    @unique // SHA-256 hash of the raw token (never the raw token)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email])
}

// ══════════════════════════════════════════════════════════════════════════════
// Mission 5.0 — COMMERCIAL OS MODELS
// ══════════════════════════════════════════════════════════════════════════════

model Customer {
  id          String   @id @default(cuid())
  type        String   @default("INDIVIDUAL") // INDIVIDUAL, COUPLE, BUSINESS, AGENCY, ORGANIZATION
  displayName String
  legalName   String?
  email       String?  @unique
  phone       String?
  whatsapp    String?
  country     String   @default("CD")
  currency    String   @default("usd")
  status      String   @default("PROSPECT") // PROSPECT, ACTIVE, INACTIVE, BLOCKED, ARCHIVED
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  weddings    Wedding[]
  deals       Deal[]
  orders      CommercialOrder[]

  @@index([status])
}

model Deal {
  id               String    @id @default(cuid())
  customerId       String
  customer         Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  leadId           String?
  lead             Lead?     @relation(fields: [leadId], references: [id], onDelete: SetNull)
  weddingId        String?
  wedding          Wedding?  @relation(fields: [weddingId], references: [id], onDelete: SetNull)
  title            String
  estimatedValue   Int?      // minor units (cents) — NO floats
  currency         String    @default("usd")
  stage            String    @default("NEW") // NEW, CONTACTED, QUALIFIED, PROPOSAL, NEGOTIATION, WON, LOST
  probability      Int       @default(0) // 0-100 (manual, not AI)
  expectedCloseDate DateTime?
  lostReason       String?
  wonAt            DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  order            CommercialOrder?

  @@index([customerId])
  @@index([stage])
}

model CommercialOrder {
  id          String    @id @default(cuid())
  customerId  String
  customer    Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  dealId      String?  @unique
  deal        Deal?     @relation(fields: [dealId], references: [id], onDelete: SetNull)
  weddingId   String?
  wedding     Wedding?  @relation(fields: [weddingId], references: [id], onDelete: SetNull)
  status      String    @default("DRAFT") // DRAFT, PENDING_CONFIRMATION, CONFIRMED, CANCELLED, COMPLETED
  currency    String    @default("usd")
  subtotal    Int       @default(0) // minor units
  discount    Int       @default(0) // minor units
  total       Int       @default(0) // minor units
  notes       String?
  confirmedAt DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  items       OrderItem[]
  payments    Payment[]
  entitlements Entitlement[]
  // Mission 6.0 P2.1 — Credits purchased via this order
  creditTransactions CreditTransaction[]

  @@index([customerId])
  @@index([status])
}

model OrderItem {
  id          String   @id @default(cuid())
  orderId     String
  order       CommercialOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  description String
  planId      String?
  quantity    Int      @default(1)
  unitPrice   Int      @default(0) // minor units
  total       Int      @default(0) // minor units
  createdAt   DateTime @default(now())

  @@index([orderId])
}

model Payment {
  id              String    @id @default(cuid())
  orderId         String
  order           CommercialOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  weddingId       String?
  wedding         Wedding?  @relation(fields: [weddingId], references: [id], onDelete: SetNull)
  amount          Int       // minor units
  currency        String    @default("usd")
  method          String    @default("MANUAL") // MANUAL, MOBILE_MONEY, BANK_TRANSFER, CASH, EXTERNAL_PROVIDER
  status          String    @default("PENDING") // PENDING, AWAITING_VERIFICATION, VERIFIED, REJECTED, FAILED, REFUNDED, PARTIALLY_REFUNDED
  reference       String?
  senderName      String?
  senderPhone     String?
  proofUrl        String?
  submittedAt     DateTime?
  verifiedAt      DateTime?
  verifiedById    String?
  verifiedBy      AdminUser? @relation(fields: [verifiedById], references: [id], onDelete: SetNull)
  rejectionReason String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([orderId])
  @@index([status])
}

model Entitlement {
  id            String   @id @default(cuid())
  weddingId     String
  wedding       Wedding  @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  type          String   // BULK_INVITATIONS, CHECK_IN, CUSTOM_DOMAIN, MAX_GUESTS, MAX_INVITATIONS, PREMIUM_COLLECTIONS
  origin        String   @default("PLAN") // PLAN, ADD_ON, MANUAL_OVERRIDE, PROMOTION, LEGACY
  value         String   @default("true") // flexible: "true", "500", "-1" for unlimited
  sourceOrderId String?
  sourceOrder   CommercialOrder? @relation(fields: [sourceOrderId], references: [id], onDelete: SetNull)
  // Mission 6.0 P3.3 — Product reference (entitlement granted by a Product purchase)
  productId     String?
  product       Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([weddingId, type]) // one entitlement per type per wedding
  @@index([weddingId])
}

model DeliveryJob {
  id            String    @id @default(cuid())
  weddingId     String
  wedding       Wedding   @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  invitationId  String?
  invitation    Invitation? @relation(fields: [invitationId], references: [id], onDelete: SetNull)
  guestId       String
  guest         Guest     @relation(fields: [guestId], references: [id], onDelete: Cascade)
  channel       String    // LINK, QR, EMAIL, SMS, WHATSAPP
  provider      String?
  destination   String?   // masked (e.g. "***@gmail.com", "+243***")
  status        String    @default("QUEUED") // QUEUED, PROCESSING, SENT, DELIVERED, READ, FAILED, CANCELLED
  attemptCount  Int       @default(0)
  lastError     String?
  createdAt     DateTime  @default(now())
  sentAt        DateTime?
  deliveredAt   DateTime?
  updatedAt     DateTime  @updatedAt

  attempts      DeliveryAttempt[]

  @@index([weddingId])
  @@index([status])
}

model DeliveryAttempt {
  id            String   @id @default(cuid())
  deliveryJobId String
  deliveryJob   DeliveryJob @relation(fields: [deliveryJobId], references: [id], onDelete: Cascade)
  provider      String?
  status        String   @default("PENDING") // SUCCESS, FAILED, PENDING
  response      String?
  error         String?
  attemptedAt   DateTime @default(now())

  @@index([deliveryJobId])
}

// ══════════════════════════════════════════════════════════════════════════════
// Mission 5.1 — PLAN OS (DB-backed plans, pricing, limits)
// ══════════════════════════════════════════════════════════════════════════════
model Plan {
  id                      String   @id @default(cuid())
  code                    String   @unique // TRIAL, ESSENTIEL, PREMIUM, ELITE
  name                    String
  description             String?
  status                  String   @default("ACTIVE") // DRAFT, ACTIVE, INACTIVE, ARCHIVED
  isPublic                Boolean  @default(true)
  sortOrder               Int      @default(0)
  priceUsdCents           Int      @default(0) // minor units
  priceFcfa               Int      @default(0)
  currency                String   @default("usd")
  maxGuests               Int      @default(-1) // -1 = unlimited
  maxMediaBytes           Int      @default(-1)
  maxAdmins               Int      @default(1)
  customDomainAllowed     Boolean  @default(false)
  bulkInvitationsAllowed  Boolean  @default(true)
  checkInAllowed          Boolean  @default(true)
  designerAllowed         Boolean  @default(true)
  premiumCollectionsAllowed Boolean @default(false)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@index([status])
  @@index([sortOrder])
}


// ══════════════════════════════════════════════════════════════════════════════
// Mission 5.7.1 — DESIGN PIPELINE MODELS
// ══════════════════════════════════════════════════════════════════════════════
// These models implement the Penpot-ready production pipeline:
//   SourceAdapter -> CanonicalDesignPackage -> Ingestion -> Mapping
//   -> CollectionEngine -> ProductCompiler -> Export
//
// All fields are additive (nullable or new models). Zero regression to
// existing 12 Collections / 408 Modules / 12 Variants / 4 Bindings.
// ══════════════════════════════════════════════════════════════════════════════

// Immutable version snapshot of a Collection's design at a given semver tag.
// Enables undo-across-sessions + audit trail without touching the
// WeddingCollectionBinding.manifest upsert pattern (which is the /w/[slug]
// read path — DO_NOT_TOUCH).
model DesignVersion {
  id                String   @id @default(cuid())
  collectionId      String
  collection        Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  version           String   // semver, e.g. "1.0.0"
  // Full WeddingManifest JSON snapshot at this version.
  manifestSnapshot  String
  // Penpot source content hash at snapshot time (for drift detection).
  sourceHash        String?
  // CanonicalDesignPackage JSON snapshot (the full design document at this version).
  designPackage     String?
  createdByUserId   String?
  createdBy         AdminUser? @relation("DesignVersionAuthor", fields: [createdByUserId], references: [id], onDelete: SetNull)
  note              String?
  createdAt         DateTime @default(now())

  @@unique([collectionId, version])
  @@index([collectionId, createdAt])
}

// Idempotent ingestion job tracker. The @@unique([collectionId, sourceHash])
// ensures that re-importing the same design (same content hash) does not
// create a duplicate job — it returns the existing one.
model IngestionJob {
  id                String   @id @default(cuid())
  collectionId      String
  collection        Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  // The source URL or fixture identifier.
  sourceUrl         String
  // Content hash for idempotency — same hash = same design = same job.
  sourceHash        String?
  // PENDING | FETCHING | PARSING | NORMALIZING | MAPPING | COMPLETED | FAILED
  status            String   @default("PENDING")
  attemptCount      Int      @default(0)
  lastError         String?
  // Cached DetectionReport JSON from the autoDetect pipeline.
  detectionReport   String?
  // The CanonicalDesignPackage JSON produced by ingestion (null until COMPLETED).
  designPackage     String?
  startedAt         DateTime?
  completedAt       DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([collectionId, sourceHash])
  @@index([collectionId, status])
}

// Batch export job for producing personalized PNG/PDF outputs from a master
// design + event data. Reuses the DeliveryJob status pattern.
model ExportJob {
  id                String   @id @default(cuid())
  weddingId         String
  wedding           Wedding  @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  collectionId      String?
  collection        Collection? @relation(fields: [collectionId], references: [id], onDelete: SetNull)
  // PNG_PDF_INVITATIONS | PNG_PDF_PRINT | PNG_PDF_COMMUNICATION | etc.
  batchType         String
  // QUEUED | PROCESSING | COMPLETED | FAILED | CANCELLED
  status            String   @default("QUEUED")
  totalItems        Int      @default(0)
  completedItems    Int      @default(0)
  // JSON array of generated asset URLs.
  outputUrls        String?
  lastError         String?
  startedAt         DateTime?
  completedAt       DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([weddingId, status])
  @@index([collectionId, status])
}


// ════════════════════════════════════════════════════════════════════════════
// CONS-3-SUPER-ADMIN — Production Studio models (platform-wide assets).
// These models are platform-wide (no weddingId) — they represent reusable
// building blocks for the Super Admin Production Studio. Use unsafePlatformDb
// to query them (no tenant scope).
// ════════════════════════════════════════════════════════════════════════════

// Wedding site templates (DRAFT/PUBLISHED/ARCHIVED). Each template ships a
// schemaJson describing its section layout (hero, gallery, timeline, rsvp...).
model Template {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  description  String   @default("")
  thumbnailUrl String?
  schemaJson   String   @default("{}") // JSON: sections config
  version      Int      @default(1)
  status       String   @default("DRAFT") // DRAFT | PUBLISHED | ARCHIVED
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Mission 6.0 P3.2 — Layout reference (optional). When set, the deployment
  // pipeline's resolveLayouts stage reads this layout's sectionsJson instead
  // of the hardcoded LAYOUT_SECTIONS map.
  layoutId     String?

  // Optional deployments using this template.
  deployments  Deployment[]
  // Mission 6.0 P3.2 — Layout relation (optional)
  layout       Layout?  @relation(fields: [layoutId], references: [id], onDelete: SetNull)

  @@index([status])
}

// Visual theme presets (color palettes + fonts). Renamed from `Theme` to
// `PlatformTheme` to avoid conflict with the existing per-wedding `Theme`
// model (line 371). These are platform-wide presets that weddings can pick.
model PlatformTheme {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  paletteJson  String   @default("{}") // { primary, accent, background }
  fontDisplay  String?
  fontBody     String?
  isBuiltIn    Boolean  @default(false)
  status       String   @default("PUBLISHED")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([status])
}

// Registry of reusable UI components (hero, gallery, timeline, rsvp-form...).
// Each entry documents its name, type, schema (props), version, status.
model ComponentRegistry {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  type        String // hero | gallery | timeline | rsvp-form | etc.
  schemaJson  String   @default("{}") // JSON schema of accepted props
  version     Int      @default(1)
  status      String   @default("PUBLISHED")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([type])
  @@index([status])
}

// Platform-wide media assets (images, videos, fonts) used across weddings.
model PlatformAsset {
  id         String   @id @default(cuid())
  name       String
  type       String // image | video | font
  url        String
  sizeBytes  Int      @default(0)
  metadata   String   @default("{}") // JSON: width, height, format, etc.
  createdAt  DateTime @default(now())

  @@index([type])
}

// Wedding frontend deployment tracking. status: PENDING | BUILDING | DEPLOYED | FAILED.
model Deployment {
  id          String    @id @default(cuid())
  weddingId   String?
  wedding     Wedding?  @relation(fields: [weddingId], references: [id], onDelete: SetNull)
  templateId  String?
  template    Template? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  // Mission 6.0 P0.6 — persist the full published config snapshot per deployment
  // so rollback is possible (previously only Wedding.publishedConfigJson held it,
  // and each new deploy overwrote the previous config with no history).
  themeId       String?
  collectionId  String?
  configJson    String?   // full PublishedConfig JSON snapshot
  version       String
  status        String    @default("PENDING") // PENDING | BUILDING | DEPLOYED | FAILED | LEGACY
  url           String?
  logsJson      String    @default("[]") // JSON array of log lines
  triggeredBy   String?   // acting admin user ID (for audit trail)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([weddingId])
  @@index([status])
  @@index([weddingId, createdAt])
}


// ══════════════════════════════════════════════════════════════════════════════
// CONS-5-CLIENT-BACKEND — Client backend (organizer) models.
// Per-wedding entities for the simplified organizer experience.
// Tenant-scoped: every row belongs to exactly one Wedding. Use `db` with
// explicit `where: { weddingId }` after `assertWeddingAccess(user, weddingId)`,
// OR use `tenantDb` inside `runWithTenant()` (auto-scoped).
// ══════════════════════════════════════════════════════════════════════════════

// Guest family (group guests by family: bride side / groom side / common).
// A family typically groups parents + siblings + children with shared contact.
model Family {
  id            String   @id @default(cuid())
  weddingId     String
  wedding       Wedding  @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  name          String
  side          String   @default("COMMON") // BRIDE | GROOM | COMMON
  contactPhone  String?
  contactEmail  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  guests        Guest[]

  @@index([weddingId])
  @@unique([weddingId, name])
}

// Guest group (friends, colleagues, VIP, church, etc.). Different from Family
// (which is blood-relation based) — a Group is any categorisation the organizer
// finds useful for seating / messaging / filtering.
model GuestGroup {
  id          String   @id @default(cuid())
  weddingId   String
  wedding     Wedding  @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  name        String
  color       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  guests      Guest[]

  @@index([weddingId])
  @@unique([weddingId, name])
}

// Wedding gift tracker (giver name, description, amount, thank-you note status).
// amount is in cents (Int) to avoid float rounding issues. currency is ISO 4217.
model Gift {
  id               String    @id @default(cuid())
  weddingId        String
  wedding          Wedding   @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  giverName        String
  giftDescription  String?
  amount           Int       @default(0) // in cents
  currency         String    @default("USD")
  receivedAt       DateTime?
  thankYouSent     Boolean   @default(false)
  note             String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([weddingId])
}

// Wedding day program item (ceremony, cocktail, dinner, dance, etc.).
// Different from EventTimeline (love-story events) — ProgramItem is the
// schedule of the wedding DAY.
// ─── Mission 6.0 P4.1 — Guestbook (Livre d'or) ──────────────────────────────
// Guests + anonymous visitors leave messages on the public wedding page.
// Messages are moderated (approved=false by default) to prevent spam/abuse.
// approvedBy = AdminUser who approved/rejected; null = pending.
model GuestbookEntry {
  id          String    @id @default(cuid())
  weddingId   String
  wedding     Wedding   @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  guestId     String?   // null = anonymous (visitor not logged in as guest)
  guest       Guest?    @relation(fields: [guestId], references: [id], onDelete: SetNull)
  authorName  String    // display name (from guest profile or visitor input)
  message     String
  rating      Int?      // optional 1-5 stars
  approved    Boolean   @default(false) // moderation: false = pending, true = visible
  approvedById String?
  approvedBy  AdminUser? @relation(fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt  DateTime?
  rejectedAt  DateTime? // if set, message was rejected by moderator
  ipAddress   String?   // for abuse tracking
  userAgent   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([weddingId, approved, createdAt])
  @@index([weddingId, createdAt])
  @@index([guestId])
}

model ProgramItem {
  id          String    @id @default(cuid())
  weddingId   String
  wedding     Wedding   @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  scheduledAt DateTime?
  title       String
  description String?
  location    String?
  iconName    String?
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([weddingId, sortOrder])
}

// ══════════════════════════════════════════════════════════════════════════════
// MISSION 6.0 — PHASE P2.1: CREDITS SYSTEM (5 types: Invitations/SMS/WhatsApp/QR/Export)
// ══════════════════════════════════════════════════════════════════════════════
// Pre-purchased consumable units. Each wedding (and optionally each organization
// for white-label billing) holds a per-type balance that is decremented atomically
// on each metered action (send invitation, send SMS, export guest list, etc.).
// The companion CreditTransaction table is an immutable ledger of every credit
// movement (purchase / consumption / refund / adjustment) for audit + reconciliation.

/// Per-wedding credit balance for one of 5 billable types.
/// Composite unique on (weddingId, type) enforces one row per type per wedding.
/// `reserved` is decremented from `balance` but kept for "in-flight" operations
/// (e.g. queued SMS) — net available = balance - reserved.
model Credit {
  id          String   @id @default(cuid())
  weddingId   String
  wedding     Wedding  @relation(fields: [weddingId], references: [id], onDelete: Cascade)

  // Optional: org-level credit (white-label resellers pre-purchase at org level
  // and the platform draws down per-wedding). When organizationId is null the
  // credit is wedding-scoped (the normal B2C case).
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  type        String   // INVITATION | SMS | WHATSAPP | QR | EXPORT
  balance     Int      @default(0)  // current available units
  reserved    Int      @default(0)  // in-flight (queued but not yet consumed/refunded)
  updatedAt   DateTime @updatedAt

  transactions CreditTransaction[]

  @@unique([weddingId, type])
  @@unique([organizationId, type])  // one org-credit per type per org (nullable → null allowed multiple)
  @@index([organizationId])
}

/// Immutable ledger of every credit movement. Append-only by design — refunds
/// are positive delta rows, never UPDATEs to historical rows.
model CreditTransaction {
  id              String   @id @default(cuid())
  weddingId       String
  wedding         Wedding  @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  organizationId  String?
  organization    Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  creditType      String   // INVITATION | SMS | WHATSAPP | QR | EXPORT (denormalized for fast filtering)
  creditId        String?
  credit          Credit?  @relation(fields: [creditId], references: [id], onDelete: SetNull)

  delta           Int      // positive = credit added; negative = consumed
  reason          String   // PURCHASE | CONSUMPTION | REFUND | ADJUSTMENT
  sourceOrderId   String?
  sourceOrder     CommercialOrder? @relation(fields: [sourceOrderId], references: [id], onDelete: SetNull)
  sourceDeliveryJobId String?
  note            String?
  createdBy       String?  // AdminUser.id who triggered the movement (null for system/webhook)
  createdAt       DateTime @default(now())

  @@index([weddingId, createdAt])
  @@index([organizationId, createdAt])
  @@index([creditType, reason])
}

/// Aggregated CreditBalance snapshot — fast read for dashboards without
/// scanning the full CreditTransaction ledger. Materialized by consumeCredit()
/// and addCredits() on every write. One row per (weddingId, type).
/// NOTE: This is technically redundant with Credit.balance, but kept as a
/// separate model so that historical "lifetime purchased" / "lifetime consumed"
/// totals can be tracked without re-scanning CreditTransaction.
model CreditBalance {
  id                  String   @id @default(cuid())
  weddingId           String
  wedding             Wedding  @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  organizationId      String?
  organization        Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  type                String   // INVITATION | SMS | WHATSAPP | QR | EXPORT
  lifetimePurchased   Int      @default(0)
  lifetimeConsumed    Int      @default(0)
  lifetimeRefunded    Int      @default(0)
  currentBalance      Int      @default(0)
  updatedAt           DateTime @updatedAt

  @@unique([weddingId, type])
  @@index([organizationId, type])
}

// ══════════════════════════════════════════════════════════════════════════════
// Mission 6.0 P3 — PIPELINE & PRODUCTION STUDIO
// 4 new pipeline stages (Brand, Layouts, Products, Experience) + governance.
// All models are platform-wide (no tenant scoping) — managed by SUPER_ADMIN
// via the Production Studio panels. The deployment pipeline reads them via
// unsafePlatformDb during resolveBrand/resolveLayouts/resolveProducts stages.
// ══════════════════════════════════════════════════════════════════════════════

// ─── P3.1 — Brand Kit ─────────────────────────────────────────────────────────
// Brand identity at the org level (agency's own brand) AND optionally at the
// couple level (their monogram, wedding colors, ceremony aesthetic). The
// resolveBrand pipeline stage embeds Brand into PublishedConfig.brand so the
// frontend renders the agency's brand badge + applies voice rules to AI copy.
model Brand {
  id              String   @id @default(cuid())
  name            String   // "AENEWS Luxury"
  slug            String   @unique
  description     String   @default("")
  logoAssetId     String?  // → PlatformAsset (best-effort link; not enforced FK to avoid coupling)
  logoUrl         String?  // direct URL (used when logoAssetId is null — e.g. external CDN)
  // JSON blobs for flexible brand guidelines (voice, iconography, do/don't)
  voiceToneJson   String   @default("{}")  // { tone, vocabulary[], do[], dont[] }
  iconographyJson String   @default("{}")  // { style, motifs[] }
  colorsJson      String   @default("{}")  // { primary, secondary, accent, background, text }
  typographyJson  String   @default("{}")  // { displayFont, bodyFont, weights }
  status          String   @default("DRAFT") // DRAFT | PUBLISHED | ARCHIVED
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Reverse relations
  organizations   Organization[]
  weddings        Wedding[]

  @@index([status])
}

// ─── P3.2 — Layout (first-class) ──────────────────────────────────────────────
// Replaces the hardcoded LAYOUT_SECTIONS map in src/lib/wedding/manifest.ts
// and the hardcoded LAYOUT_OPTIONS array in src/lib/themes/templates.ts.
// Designers can publish new layouts without code changes. The resolveLayouts
// pipeline stage reads sectionsJson and merges it into the wedding manifest.
model Layout {
  id           String   @id @default(cuid())
  name         String   // "Royal Gold"
  slug         String   @unique
  description  String   @default("")
  // JSON: ManifestSection[] (ordered) — same shape as LAYOUT_SECTIONS values
  sectionsJson String   @default("[]")
  // JSON: default props per section (e.g. { hero: { variant: "split" } })
  propsJson    String   @default("{}")
  thumbnailUrl String?
  version      Int      @default(1)
  status       String   @default("DRAFT") // DRAFT | PUBLISHED | ARCHIVED
  isBuiltIn    Boolean  @default(false) // true for the 5 original layouts migrated from manifest.ts
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Reverse relations
  templates    Template[]
  weddings     Wedding[]

  @@index([status])
}

// ─── P3.3 — Product (sellable pipeline artifact) ─────────────────────────────
// A Product bundles 1+ Collections + add-ons (print materials, SMS credits,
// custom domain) + pricing + licensing. Sits ABOVE Collection in the pipeline
// vision — Collection remains the design bundle, Product wraps it with commerce.
// The resolveProducts pipeline stage verifies the wedding's Entitlement grants
// access to all Collections referenced in the bundle.
model Product {
  id           String   @id @default(cuid())
  name         String   // "Royal Gold Complete"
  slug         String   @unique
  description  String   @default("")
  // JSON: { collectionIds: [], addOns: [], features: [] }
  // - collectionIds: array of Collection.id that this product bundles
  // - addOns: array of { type: "SMS_CREDITS"|"EXPORT_CREDITS"|..., quantity: N }
  // - features: array of { key: "CUSTOM_DOMAIN"|"PREMIUM_QR"|..., value: "true"|"500" }
  bundleJson   String   @default("{}")
  priceCents   Int      @default(0) // in cents (e.g. 4999 = $49.99)
  currency     String   @default("USD")
  licence      String   @default("STANDARD") // STANDARD | EXCLUSIVE | CUSTOM
  status       String   @default("DRAFT") // DRAFT | PUBLISHED | ARCHIVED
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // 1 Product → N Entitlements (post-purchase access records)
  entitlements Entitlement[]

  @@index([status])
}

// ─── P3.4 — Experience (post-deploy analytics, A/B, journey) ─────────────────
// The pipeline ends at publishFrontend today — no post-deployment analytics,
// no A/B variant assignment, no personalization. The Experience layer observes
// how guests interact with the deployed frontend and feeds back into A/B testing.
// The resolveExperience pipeline stage (post-publishFrontend) initializes the
// default A/B variants for the wedding's active sections.

// Raw event stream — written by the public /api/weddings/[id]/experience/track
// endpoint (called from the guest-facing frontend via beacon). High volume.
model ExperienceEvent {
  id           String   @id @default(cuid())
  weddingId    String
  wedding      Wedding  @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  guestId      String?  // nullable for anonymous visitors
  eventType    String   // SCROLL | CLICK | RSVP_VIEW | PHOTO_TAP | SECTION_VIEW | TIME_SPENT | ...
  sectionId    String?  // which manifest section (e.g. "hero", "gallery")
  variantId    String?  // A/B variant code (A | B | C)
  payloadJson  String   @default("{}")
  createdAt    DateTime @default(now())

  @@index([weddingId, createdAt])
  @@index([weddingId, eventType])
}

// A/B variant configuration — which variant a guest sees for a given section.
// One row per (weddingId, sectionId, variantCode). The guest frontend picks
// the variant deterministically (hash of guestId + sectionId) weighted by trafficPct.
model ExperienceVariant {
  id           String   @id @default(cuid())
  weddingId    String
  wedding      Wedding  @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  sectionId    String   // "hero" | "gallery" | "rsvp" | ...
  variantCode  String   // "A" | "B" | "C"
  trafficPct   Int      @default(50) // 0-100
  description  String   @default("")
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([weddingId, sectionId, variantCode])
  @@index([weddingId, sectionId])
}

// Aggregated report per wedding per period (daily/weekly/monthly). Materialized
// by a scheduled job (TODO P3.4 cron) from ExperienceEvent. Fast read for the
// ExperienceManager dashboard without scanning the raw event stream.
model ExperienceReport {
  id           String   @id @default(cuid())
  weddingId    String
  wedding      Wedding  @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  periodStart  DateTime
  periodEnd    DateTime
  granularity  String   @default("DAILY") // DAILY | WEEKLY | MONTHLY
  // JSON: { sectionEngagement: { sectionId: { views, avgTimeSec, bounceRate } },
  //         variantPerformance: { sectionId: { variantCode: { conversionRate, ... } } },
  //         topEvents: [{ eventType, count }] }
  metricsJson  String   @default("{}")
  createdAt    DateTime @default(now())

  @@unique([weddingId, periodStart, granularity])
  @@index([weddingId, periodStart])
}
