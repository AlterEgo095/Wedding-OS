generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model AdminUser {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  role      String   @default("CONTROLLER") // SUPER_ADMIN, ORGANIZER, CONTROLLER, RECEPTION
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  auditLogs AuditLog[]
}

model Guest {
  id                String           @id @default(cuid())
  firstName         String
  lastName          String
  phone             String?
  email             String?
  tableId           String?
  seats             Int              @default(1)
  category          String           @default("AMIS") // VIP, FAMILLE, AMIS, SPONSORS, COLLEGUES
  status            String           @default("PENDING") // CONFIRMED, PENDING, DECLINED
  invitationCode    String           @unique
  personalMessage   String?
  checkedIn         Boolean          @default(false)
  checkedInAt       DateTime?
  invitationViewed  Boolean          @default(false)
  invitationViewedAt DateTime?
  invitationViewCount Int            @default(0)
  lastAccessAt      DateTime?
  // ─── RSVP Fields ───
  rsvpAt            DateTime?        // When guest confirmed/declined
  rsvpMessage       String?          // Optional message from guest
  rsvpPlusOne       Boolean          @default(false) // Bringing additional guest
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  table             Table?           @relation(fields: [tableId], references: [id])
  sessions          GuestSession[]
  accessLogs        GuestAccessLog[]
}

model Table {
  id       String   @id @default(cuid())
  name     String
  number   Int      @unique
  capacity Int      @default(8)
  location String?  // JSON string for position: {"x": 0, "y": 0}
  guests   Guest[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Media {
  id          String   @id @default(cuid())
  type        String   // PHOTO, VIDEO, LOGO, DOCUMENT
  url         String
  title       String?
  description String?
  category    String?  // GALLERY, COUPLE_STORY, DOCUMENT, OTHER
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model EventTimeline {
  id          String   @id @default(cuid())
  time        String
  activity    String
  location    String?
  description String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model CoupleStory {
  id          String   @id @default(cuid())
  title       String
  description String
  date        String?
  imageUrl    String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  details   String?
  createdAt DateTime @default(now())
  user      AdminUser? @relation(fields: [userId], references: [id])
}

model Settings {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ─── Guest Session Management ───
model GuestSession {
  id            String   @id @default(cuid())
  guestId       String
  token         String   @unique
  userAgent     String?
  ipAddress     String?
  fingerprint   String?  // Device fingerprint hash
  deviceInfo    String?  // JSON: { browser, os, device, isMobile }
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  expiresAt     DateTime
  lastAccessedAt DateTime @default(now())
  guest         Guest    @relation(fields: [guestId], references: [id], onDelete: Cascade)
}

// ─── Guest Access Logging ───
model GuestAccessLog {
  id          String   @id @default(cuid())
  guestId     String?
  action      String   // LOGIN, VIEW_INVITATION, ACCESS_DENIED, LOGOUT, QR_SCAN, LINK_VISIT, SEARCH_BLOCKED
  details     String?
  userAgent   String?
  ipAddress   String?
  referrer    String?
  fingerprint String?  // Device fingerprint hash
  deviceInfo  String?  // JSON: { browser, os, device, isMobile }
  createdAt   DateTime @default(now())
  guest       Guest?   @relation(fields: [guestId], references: [id], onDelete: SetNull)
}
