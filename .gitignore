# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel


# typescript
*.tsbuildinfo
next-env.d.ts
local-*
.claude
.z-ai-config
*.log
dev.log
dev.out.log
test
prompt

server.log

# Tool result artifacts (agent working files, must never be tracked)
/tool-results/

# Local dev server runtime files
/.zscripts/dev.pid
/.zscripts/dev.out.log

# Worklog is a local agent scratchpad, keep out of repo
/worklog.md

# Skills directory
/skills/
# Database files (never track SQLite DBs)
/db/*.db
/db/*.db-journal
/prisma/*.db

# Local VPS deploy tool (contains no secrets, reads from env)
/.zscripts/vps-ssh.py
.env

# Audit/report screenshots and artifact dumps (not source)
*.png
# P0-PWA-1: PWA icons must be tracked (not ignored by *.png rule)
!public/icons/*.png
!public/icons/**/*.png
audit-*.md
AUDIT_STRATEGIQUE_GLOBAL.md
p3-screenshots/
p3-screenshots-v2/
p4-screenshots/
screenshots/
backup-frontend/
phase4-*.bundle
phase4-*.sh
deploy-*.mjs
deploy-collection-engine.mjs
deploy-phase2-modules.mjs
deploy-phase4.mjs
public/PENPOT_COLLECTION_SPEC.md
docs/PHASE0_REPORT.md
docs/PHASE1_REPORT.md
agent-ctx/
.zscripts/vps_ssh.example.py
scripts/backup-db.cron.example

# VPS SSH credentials — NEVER commit
.zscripts/.vps-creds
.zscripts/vps_ssh.py
