# ─── Wedding OS — environment variables ──────────────────────────────────────
# Copy this file to `.env` and fill in real values for your deployment.
# NEVER commit the real `.env` file — it is .gitignored.

# ─── Core application ────────────────────────────────────────────────────────
NODE_ENV=development
# Public base URL of the deployment (used in invitation links, password-reset
# URLs, CORS, etc.). MUST match the externally reachable URL.
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# ─── Database ────────────────────────────────────────────────────────────────
# SQLite (dev) — file path relative to repo root.
# PostgreSQL (prod) — full connection string.
DATABASE_URL="file:./dev.db"

# ─── Authentication secrets (REQUIRED in production) ─────────────────────────
# JWT_SECRET — signs stateless admin/guest JWTs. Rotating it invalidates ALL
#             sessions. Minimum 32 chars. Generate with:
#             openssl rand -base64 48
JWT_SECRET=

# ENCRYPTION_KEY — AES-256-GCM key for at-rest encryption (invitation link
#                  tokens, 2FA TOTP secrets). MUST be distinct from JWT_SECRET
#                  (the app refuses to start if they are equal). Rotating it
#                  invalidates existing encrypted linkTokens + 2FA secrets
#                  (guests must re-auth, admins must re-setup 2FA). Min 32 chars.
#                  Generate with: openssl rand -base64 48
ENCRYPTION_KEY=

# ─── Platform admin bootstrap (used by `prisma/seed.ts`) ─────────────────────
# Email + password for the initial PLATFORM_ADMIN account created by the seed
# script. REQUIRED in production — the seed throws if unset.
PLATFORM_ADMIN_EMAIL=admin@example.com
PLATFORM_ADMIN_PASSWORD=

# Set to "1" (or "true") to also seed demo couple + sample guests + tables +
# timeline + couple stories. Leave unset in production.
SEED_DEMO_DATA=1

# ─── Rate limiting / brute-force protection ──────────────────────────────────
# Optional — sensible defaults are applied if unset.
# BRUTE_FORCE_BAN_MINUTES=60
# MAX_LOGIN_ATTEMPTS_PER_HOUR=10
# GUEST_SESSION_DAYS=30

# ─── Redis (optional — for distributed rate-limiting across instances) ──────
# When unset, the rate limiter falls back to in-memory (single-instance only).
# REDIS_URL=redis://localhost:6379

# ─── Email sending (password reset, notifications) ───────────────────────────
# Currently the platform uses a structured-logger stub for outbound email.
# When a real provider is wired (Resend / Postmark / SES), set these:
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM="Heureux Mariage <noreply@example.com>"
